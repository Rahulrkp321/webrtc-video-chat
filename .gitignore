# ============================================
# Git Ignore File for WebRTC Video-Chat
# ============================================
# Files and folders listed here will NOT be
# uploaded to GitHub
# ============================================

# Dependencies (downloaded via npm install)
node_modules/

# Environment files (contain secrets)
.env
.env.local
.env.production

# Log files
logs/
*.log
npm-debug.log*

# Operating System files
.DS_Store
.DS_Store?
Thumbs.db

# IDE/Editor folders
.vscode/
.idea/
*.swp
*.swo

# Build output
dist/
build/

# Temporary files
tmp/
temp/
*.tmp

